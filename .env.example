# ============================================
# PROJECT BOLD - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ============================================
# TEAM ADMIN KEYS (REQUIRED FOR PRODUCTION)
# ============================================
# Each team gets their own admin key for scoped access.
# Generate secure keys: openssl rand -base64 32
#
# Project Bold Leads - Full superadmin access to everything
ADMIN_KEY_LEADS=change-this-to-a-secure-random-key
# Outreach Team - Manages their assigned policies only
ADMIN_KEY_OUTREACH=change-this-to-a-secure-random-key
# Communications Team - Manages their assigned policies only
ADMIN_KEY_COMMS=change-this-to-a-secure-random-key
# Strategy Team - Manages their assigned policies only
ADMIN_KEY_STRATEGY=change-this-to-a-secure-random-key

# Legacy single key (fallback for ADMIN_KEY_LEADS if set)
# ADMIN_KEY=change-this-to-a-secure-random-key

# ============================================
# FORM SUBMISSIONS
# ============================================
# Web3Forms API key for form submissions
# Get your FREE key at: https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-key-here

# ============================================
# AI VALIDATION (Groq - LLAMA 3.3)
# ============================================
# Get your FREE API key at: https://console.groq.com
# Used for real-world price validation of funding requests
GROQ_API_KEY=your-groq-api-key-here

# ============================================
# DATABASE (Optional - Supabase)
# ============================================
# Get these from your Supabase project settings > API
# If not set, the app will use localStorage only

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# DEPLOYMENT SETTINGS
# ============================================
# Your production domain (used for CORS and security headers)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# SETUP INSTRUCTIONS
# ============================================
#
# QUICK START:
# 1. Copy this file: cp .env.example .env.local
# 2. Generate a secure admin key: openssl rand -base64 32
# 3. Paste it as ADMIN_KEY value
# 4. (Optional) Get a Web3Forms key for form submissions
# 5. (Optional) Set up Supabase for persistent storage
# 6. Run: npm run dev
#
# SUPABASE SETUP (for persistent data):
# 1. Create a free Supabase account at https://supabase.com
# 2. Create a new project
# 3. Go to Settings > API and copy:
#    - Project URL -> NEXT_PUBLIC_SUPABASE_URL
#    - anon public key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4. Go to SQL Editor and run the schema from:
#    supabase-schema.sql
#
# PRODUCTION DEPLOYMENT (Vercel):
# Add these as Environment Variables in your Vercel project:
# - ADMIN_KEY_LEADS (superadmin - full access)
# - ADMIN_KEY_OUTREACH (outreach team)
# - ADMIN_KEY_COMMS (communications team)
# - ADMIN_KEY_STRATEGY (strategy team)
# - NEXT_PUBLIC_WEB3FORMS_KEY
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - NEXT_PUBLIC_SITE_URL

# ============================================
# xAI / Grok Configuration (for UNC Gov Codex)
# ============================================
# Get your API key from https://console.x.ai
# This key is server-side only (not exposed to browser)
XAI_API_KEY=your-xai-api-key-here

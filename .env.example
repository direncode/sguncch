# ============================================
# PROJECT BOLD - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Optional)
# Get these from your Supabase project settings > API
# If not set, the app will use localStorage only

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# SETUP INSTRUCTIONS
# ============================================
#
# 1. Create a free Supabase account at https://supabase.com
#
# 2. Create a new project
#
# 3. Go to Settings > API and copy:
#    - Project URL -> NEXT_PUBLIC_SUPABASE_URL
#    - anon public key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# 4. Go to SQL Editor and run the schema from:
#    supabase-schema.sql
#
# 5. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 6. Fill in your Supabase credentials
#
# 7. Restart the dev server:
#    npm run dev
#
# xAI / Grok API Configuration (Optional)
# Powers the AI Document Reader on the Documents page
# Get your API key from https://console.x.ai
# Server-side only — never exposed to client directly

XAI_API_KEY=your-xai-api-key-here

# ============================================
# OPTIONAL: If using Vercel deployment
# ============================================
# Add these as Environment Variables in your
# Vercel project settings:
#
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY
# XAI_API_KEY

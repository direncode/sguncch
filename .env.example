# Project Bold Policy Platform - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# GENERAL
# =============================================================================
NODE_ENV=development
APP_NAME="Project Bold Platform"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://projectbold:projectbold@localhost:5432/projectbold_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectbold_dev
DB_USER=projectbold
DB_PASSWORD=projectbold

# =============================================================================
# REDIS (Sessions/Cache)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SAML/Shibboleth Configuration (UNC SSO)
SAML_ENABLED=false
SAML_MOCK_MODE=true
SAML_ENTRY_POINT=https://sso.unc.edu/idp/profile/SAML2/Redirect/SSO
SAML_ISSUER=https://projectbold.unc.edu
SAML_CALLBACK_URL=http://localhost:4000/auth/saml/callback
SAML_CERT_PATH=./certs/unc-idp.pem
SAML_PRIVATE_KEY_PATH=./certs/sp-private.key

# =============================================================================
# UNC INTEGRATIONS
# =============================================================================
# Canvas LTI 1.3 Configuration
CANVAS_LTI_ENABLED=false
CANVAS_CLIENT_ID=
CANVAS_DEPLOYMENT_ID=
CANVAS_PLATFORM_URL=https://canvas.unc.edu
CANVAS_JWKS_URL=https://canvas.unc.edu/api/lti/security/jwks
CANVAS_ACCESS_TOKEN_URL=https://canvas.unc.edu/login/oauth2/token
CANVAS_AUTH_URL=https://canvas.unc.edu/api/lti/authorize_redirect

# ConnectCarolina (Placeholder - requires ITS partnership)
CONNECT_CAROLINA_ENABLED=false
CONNECT_CAROLINA_API_URL=

# =============================================================================
# AI SERVICES
# =============================================================================
# OpenAI (for peer matching, recommendations)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (alternative AI provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# AI Feature Flags
AI_MATCHING_ENABLED=false
AI_RECOMMENDATIONS_ENABLED=false
AI_EARLY_ALERTS_ENABLED=false

# =============================================================================
# EMAIL (Notifications)
# =============================================================================
SMTP_HOST=smtp.unc.edu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Project Bold <noreply@projectbold.unc.edu>"

# =============================================================================
# SECURITY
# =============================================================================
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=your-session-secret-change-in-production

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=dev

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_WELLNESS_MODULE=true
FEATURE_PEER_MENTORSHIP=true
FEATURE_CIVIC_HOURS=true
FEATURE_CULTURAL_CALENDAR=true
FEATURE_TRANSPARENCY_DASHBOARD=true
FEATURE_FOOD_RESOURCES=true
